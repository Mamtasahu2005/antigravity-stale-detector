{
  "$schema": "https://www.getbifrost.ai/schema",
  "config_store": {
    "enabled": false
  },
  "client": {
    "enforce_auth_on_inference": false
  },
  "providers": {
    "groq": {
      "keys": [
        {
          "name": "primary",
          "value": "env.GROQ_API_KEY",
          "models": ["*"],
          "weight": 1.0
        }
      ]
    }
  }
}
