# Streamlit Cloud secrets template
# Go to: share.streamlit.io -> your app -> Settings -> Secrets
# Paste the block below with your real values.
# IMPORTANT: these are TOP-LEVEL keys. Do NOT wrap them in a [secrets] section.

BIFROST_KEY = "sk-bf-xxxxxxxx"
BIFROST_URL = "https://your-bifrost-gateway.onrender.com"
TAVILY_KEY  = "tvly-xxxxxxxx"
